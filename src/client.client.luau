MesaState.start()
require(Client.Efeitos).start()
task.spawn(require(Client.Ambiente).start) -- espera o cenário chegar; não segura o resto
require(Client.AmbienteMundo).start() -- luz por zona: sala (noite), vila (tarde), floresta (crepúsculo)
require(Client.BoardView).start(MesaState)
require(Client.MesaPanel).start(MesaState)
-- Fatia A1 (Árvore do Fogo): barra de ações do turno e animações das magias.
require(Client.AcoesDoTurno).start(MesaState)
require(Client.Magias).start(MesaState)
require(Client.VozesNPCsView).start(MesaState)
require(Client.DojoView).start()
require(Client.RunView).start()
require(Client.TreinadorView).start()
require(Client.DialogoNpcView).start(MesaState)
require(Client.NpcsVida).start()
require(Client.ObjetivoView).start(MesaState)
require(Client.ContaView).start()
require(Client.RelogioRunView).start()
require(Client.AjudaView).start()
require(Client.Atalhos).start() -- esconde os atalhos do canto enquanto um painel grande está aberto (celular)
require(Client.LojaView).start(MesaState)
require(Client.MissaoView).start(MesaState)
-- A árvore usa botão próprio; T continua reservado à entrega da ficha no lobby.
-- HUD de jogo: seu PV/PM sempre à vista e a ordem dos turnos.
require(Client.Hud).start(MesaState)
require(Client.BardoView).start(MesaState)
require(Client.ChefeView).start(MesaState)
