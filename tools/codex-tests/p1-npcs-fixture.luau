-- DIALOGO_ESTADO_SOURCE
 end)()
end
local Estado = criar()
assert(Estado.receber() == true, "consulta normal preservada")
Estado.iniciar()
assert(Estado.receber() == false, "consulta antecipada permanece recolhida")
assert(Estado.escolher() == true, "cache pronto abre ao escolher")
Estado.fechar()
assert(Estado.receber() == false, "fechar missões impede resposta tardia de reabrir")
Estado = criar()
Estado.iniciar()
assert(Estado.escolher() == false, "escolher antes da rede aguarda snapshot")
assert(Estado.receber() == true, "snapshot tardio abre opção selecionada")
Estado.iniciar()
Estado.fechar()
assert(Estado.receber() == false, "sair ou mudar NPC mantém resposta tardia recolhida")
Estado.iniciar()
assert(Estado.escolher() == true, "Falar durante cooldown reutiliza cache confirmado sem aguardar novo snapshot")
print("P1 NPCs: cache, resposta tardia, fechar e Falar no cooldown ok")
