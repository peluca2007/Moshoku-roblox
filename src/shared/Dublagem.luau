-- Variantes com ID cujo nome começa por `prefixo` (ex.: "grito__deus-da-espada__investida-espada").
function Dublagem.variantes(prefixo: string): { string }
	local lista = {}
	for chave in Dublagem.IDS do
		if string.sub(chave, 1, #prefixo) == prefixo then
			table.insert(lista, chave)
		end
	end
	table.sort(lista)
	return lista
end

return Dublagem
